// repository.at — TODO-001：SQLite 单写者可靠存储。
//
// 能力依据：docs/plans/evidence/001/capability-decision.md（T-01 应用内实测探针：
// BEGIN IMMEDIATE 排他、回滚、SQLITE_BUSY 双连接排他、'' 转义 + 中文/引号/换行
// 往返全部通过；a2r-std rusqlite bundled）。
// SQLite（a2r-std 封装）提供：事务原子提交、跨连接/跨进程排他（busy_timeout +
// SQLITE_BUSY → second_writer）、崩溃安全（WAL + 回滚）。
//
// 本模块不导入 api 类型（避免 api→db→repository 循环导入）：全部 I/O 为
// JSON 字符串；db.at 解析并构造 Todo 视图。
//
// 模式（schema_v=1；每次打开 quick_check 门禁，变更与读取共用入口）：
//   todos(id INTEGER PRIMARY KEY, text TEXT NOT NULL, done INTEGER NOT NULL)
//   meta(k TEXT PRIMARY KEY, v TEXT NOT NULL)   -- schema_v, next_id
// 写路径：data_dir 建目录 → sqlite.open → quick_check → BEGIN IMMEDIATE →
//   以 DB 当前状态做检查（存在性/空白）→ 写入 → COMMIT → 备份（VACUUM INTO）。
//   任一步失败 → ROLLBACK + 结构化错误，绝无部分状态。
// ID：meta.next_id 单调分配器，与 MAX(id) 取大；删除最大 ID 后不复用（AC-02）。
// 种子：绝无运行时种子（AC-01 全新库为空）；旧内存演示样本只在测试 fixture
//   （tests/basic/fixtures/seed_demo.json）中，由测试工具直接写入隔离库。
// 备份：每次成功变更后 VACUUM INTO todos.db.bak（一致性单文件快照，best-effort）；
//   打开遇 corrupt → 先试 bak 校验恢复（原件保留为 todos.db.corrupt），失败则
//   明确报错，绝不静默重建覆盖（AC-03/V-03）。
// 故障注入：AUTO_TODO_FAULT=write_fail|commit_fail|after_commit_fail（仅测试，
//   语义见各写入口注释；verify_basic 用它做提交中断回放）。

use auto.env
use auto.json
use auto.sqlite

// ═══════════════════════════════════════════════════════════
// 数据目录与路径
// ═══════════════════════════════════════════════════════════

/// 数据根：AUTO_TODO_DATA 显式覆盖（测试隔离）；默认用户数据目录
/// （APPDATA → XDG_DATA_HOME → HOME/.local/share），绝不落源码/生成目录。
pub fn data_dir() str {
    var ov str = env.get("AUTO_TODO_DATA")
    var base str = ov
    if base == "" {
        base = env.get("APPDATA")
    }
    if base == "" {
        base = env.get("XDG_DATA_HOME")
    }
    if base == "" {
        base = env.get("HOME") + "/.local/share"
    }
    if base == "" {
        base = "."
    }
    var dir str = base + "/auto-todo/data"
    if ov != "" {
        dir = ov
    }
    // 目录必须真实存在：sqlite.open 对缺父目录的路径会静默回退内存库
    // （哨兵约定），写入全部落空。每次解析即兜底建目录。
    fs.mkdir_all(dir)
    return dir
}

pub fn db_path() str {
    return data_dir() + "/todos.db"
}

fn bak_path() str {
    return data_dir() + "/todos.db.bak"
}

// ═══════════════════════════════════════════════════════════
// 基础助手
// ═══════════════════════════════════════════════════════════

/// SQL 字符串字面量：单引号包裹 + 内部 ' 翻倍（bundled SQLite DQS=0，
/// 双引号是标识符不是字面量——json.encode 的双引号在 VALUES/WHERE 里必炸）。
fn sql_str(s str) str {
    return "'" + s.replace("'", "''") + "'"
}

fn parse_int(s str) int {
    var r int = 0
    var neg bool = false
    var i int = 0
    var n int = s.len()
    if n > 0 {
        var c0 int = s.char_at(0)
        if c0 == 45 {
            neg = true
            i = 1
        }
    }
    while i < n {
        var cp int = s.char_at(i)
        if cp >= 48 {
            if cp <= 57 {
                r = r * 10 + cp - 48
            }
        }
        i = i + 1
    }
    if neg {
        r = 0 - r
    }
    return r
}

fn is_blank_text(s str) bool {
    return s.trim() == ""
}

/// 故障注入门（仅测试；生产环境不设置 AUTO_TODO_FAULT）
fn fault() str {
    return env.get("AUTO_TODO_FAULT")
}

/// fs.delete 包装：a2r 发射器对语句位 fs_delete(var) 按值移动 String
/// （E0382），经 str 参数包装取得借用语义。
fn fs_delete(p str) bool {
    return fs.delete(p)
}

fn err_envelope(code str) str {
    var lerr str = sqlite.last_error()
    return err_detail_envelope(code, lerr)
}

/// 语义类失败（blank_input/not_found）不带存储层噪声，detail 显式可读。
fn err_detail_envelope(code str, detail str) str {
    return "{\"ok\":false,\"err_code\":" + json.encode(code) + ",\"err_detail\":" + json.encode(detail) + ",\"todo\":{\"id\":-1,\"text\":\"\",\"done\":false},\"count\":0}"
}

fn ok_envelope(todo_json str, count int) str {
    return "{\"ok\":true,\"err_code\":\"\",\"err_detail\":\"\",\"todo\":" + todo_json + ",\"count\":" + json.encode(count) + "}"
}

fn row_to_todo_json(row List<str>) str {
    var done str = "false"
    if row[2] == "1" {
        done = "true"
    }
    var s str = "{\"id\":" + row[0] + ",\"text\":" + json.encode(row[1]) + ",\"done\":" + done + "}"
    return s
}

// ═══════════════════════════════════════════════════════════
// 打开与 schema 门禁
// ═══════════════════════════════════════════════════════════

/// 对单个库文件做结构校验：连接 + quick_check。返回 "" 或 "corrupt"。
/// 独立函数作用域保证连接 RAII 关闭，供恢复路径在无连接时拷贝文件。
fn verify_db_file(path str) str {
    var db SqliteDb = sqlite.open(path)
    db.exec("PRAGMA busy_timeout=3000")
    if fs.exists(path) == false {
        // sqlite.open 失败会静默回退内存库——真实文件未建立即不可用
        return "storage_unwritable"
    }
    var rows List<List<str>> = db.query("PRAGMA quick_check")
    if rows.len() < 1 {
        return "corrupt"
    }
    var row0 = rows[0]
    if row0[0] != "ok" {
        return "corrupt"
    }
    return ""
}

/// 打开门禁（读/写共用）：恢复标记 → quick_check → DDL → schema_v 校验。
/// 返回 ""；失败码：storage_unwritable | corrupt | schema_unsupported。
fn ensure_schema() str {
    // 恢复进行中/失败残留：绝不静默重建空库覆盖（AC-03）
    if fs.exists(db_path() + ".recovering") {
        return "corrupt"
    }
    var db SqliteDb = sqlite.open(db_path())
    db.exec("PRAGMA busy_timeout=3000")
    db.exec("PRAGMA journal_mode=WAL")
    if fs.exists(db_path()) == false {
        return "storage_unwritable"
    }
    // 损坏检测先于任何 DDL：绝不给损坏文件建表（原件保持不变）
    var rows List<List<str>> = db.query("PRAGMA quick_check")
    if rows.len() < 1 {
        return "corrupt"
    }
    var row0 = rows[0]
    if row0[0] != "ok" {
        return "corrupt"
    }
    db.exec("CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT NOT NULL)")
    db.exec("CREATE TABLE IF NOT EXISTS todos(id INTEGER PRIMARY KEY, text TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0)")
    var sv str = meta_get_on(db, "schema_v")
    if sv == "" {
        var cnt_rows List<List<str>> = db.query("SELECT COUNT(*) FROM todos")
        var empty bool = true
        if cnt_rows.len() > 0 {
            var c = cnt_rows[0]
            if parse_int(c[0]) > 0 {
                empty = false
            }
        }
        if empty {
            // 全新库：版本与分配器初始化（空库 = 0 任务，无种子）
            var w1 int = db.exec("INSERT INTO meta(k, v) VALUES('schema_v', '1')")
            var w2 int = db.exec("INSERT INTO meta(k, v) VALUES('next_id', '1')")
            if w1 < 0 {
                return "storage_unwritable"
            }
            if w2 < 0 {
                return "storage_unwritable"
            }
        } else {
            return "schema_unsupported"
        }
    } else {
        if sv != "1" {
            return "schema_unsupported"
        }
    }
    return ""
}

/// 变更/读取共用入口。corrupt 时尝试一次备份恢复（AC-03/V-03）。
/// 返回 ""；失败码：storage_unwritable | corrupt | schema_unsupported。
pub fn open_repository() str {
    var err str = ensure_schema()
    if err != "corrupt" {
        return err
    }
    var rerr str = try_recover()
    if rerr != "" {
        return rerr
    }
    return ensure_schema()
}

/// 备份恢复（主库 corrupt 时的一次机会）：
///   bak 在且 quick_check 通过 → 打标记 → 复核主件仍损坏（并发守卫）→
///   删损坏主件 → VACUUM INTO 复制 bak→主件 → 复验 → 清标记。
///   任一步失败保持 corrupt（标记挡住静默重建，bak 完好可重试）；
///   bak 不可用时主件字节保持不动（V-03 原件哈希不变）。
/// a2r 发射器无 fs.copy 映射，文件级复制经 SQLite VACUUM INTO 完成。
/// 单写者合同下同一时刻至多一个恢复者；复核守卫拦截标记写入前后的窄窗竞争。
fn try_recover() str {
    var mp str = db_path()
    var bp str = bak_path()
    if fs.exists(bp) == false {
        return "corrupt"
    }
    if verify_db_file(bp) != "" {
        return "corrupt"
    }
    // 并发守卫：验证 bak 期间他方可能已完成恢复——主件已有效则直接放行
    if verify_db_file(mp) == "" {
        return ""
    }
    fs.write_text(mp + ".recovering", "1")
    fs_delete(mp + "-wal")
    fs_delete(mp + "-shm")
    fs_delete(mp)
    var bak SqliteDb = sqlite.open(bp)
    var v int = bak.exec("VACUUM INTO " + sql_str(mp))
    if v < 0 {
        return "corrupt"
    }
    if verify_db_file(mp) != "" {
        return "corrupt"
    }
    fs_delete(mp + ".recovering")
    return ""
}

/// 每次成功变更后的备份（best-effort：主提交已持久；备份失败不回滚用户数据）。
/// VACUUM INTO 生成一致性单文件快照，规避 WAL 拷贝窗口。
fn backup_after_commit(db SqliteDb) {
    var bp str = bak_path()
    fs_delete(bp)
    db.exec("VACUUM INTO " + sql_str(bp))
}

fn meta_get_on(db SqliteDb, k str) str {
    var sql str = "SELECT v FROM meta WHERE k=" + sql_str(k)
    var rows List<List<str>> = db.query(sql)
    if rows.len() > 0 {
        var row0 = rows[0]
        return row0[0]
    }
    return ""
}

/// 单调 ID 分配器：max(meta.next_id, MAX(id)+1, 1)。
/// 删除最大 ID 后分配器不回退（AC-02 不复用）。
fn next_id_on(db SqliteDb) int {
    var v int = 1
    var mrows List<List<str>> = db.query("SELECT v FROM meta WHERE k='next_id'")
    if mrows.len() > 0 {
        var mrow = mrows[0]
        var c int = parse_int(mrow[0])
        if c > v {
            v = c
        }
    }
    var rows List<List<str>> = db.query("SELECT COALESCE(MAX(id), 0) FROM todos")
    if rows.len() > 0 {
        var row0 = rows[0]
        var m int = parse_int(row0[0]) + 1
        if m > v {
            v = m
        }
    }
    return v
}

/// 事务内分配器推进（同事务提交，绝无跨进程重用）
fn bump_next_id_on(db SqliteDb, used int) int {
    var nv int = used + 1
    return db.exec("INSERT INTO meta(k, v) VALUES('next_id', " + json.encode(nv) + ") ON CONFLICT(k) DO UPDATE SET v=" + json.encode(nv))
}

// ═══════════════════════════════════════════════════════════
// 读取
// ═══════════════════════════════════════════════════════════

/// 全量任务（id 升序 = 插入序）。信封：{"ok":..,"err_code":..,"todos":[..]}
pub fn repo_list() str {
    var oerr str = open_repository()
    if oerr != "" {
        return "{\"ok\":false,\"err_code\":" + json.encode(oerr) + ",\"todos\":[]}"
    }
    var db SqliteDb = sqlite.open(db_path())
    var rows List<List<str>> = db.query("SELECT id, text, done FROM todos ORDER BY id ASC")
    var out str = "["
    var n int = rows.len()
    for k in 0..n {
        var row = rows[k]
        if k > 0 {
            out = out + ","
        }
        out = out + row_to_todo_json(row)
    }
    out = out + "]"
    return "{\"ok\":true,\"err_code\":\"\",\"todos\":" + out + "}"
}

// ═══════════════════════════════════════════════════════════
// 变更（BEGIN IMMEDIATE 门禁覆盖检查+写区间）
// 故障注入语义：
//   write_fail        → BEGIN 后立即回滚，报 fault_injected（模拟介质拒写）
//   commit_fail       → 写入后回滚，报 fault_injected（模拟提交前中断；库无痕）
//   after_commit_fail → 提交后报 fault_injected（模拟提交后崩溃；数据已持久，
//                       无成功回执——重启后可见，恢复语义在 Spec 增量中说明）
// ═══════════════════════════════════════════════════════════

pub fn repo_create(text str) str {
    if is_blank_text(text) {
        return err_detail_envelope("blank_input", "todo text must not be blank")
    }
    var oerr str = open_repository()
    if oerr != "" {
        return err_envelope(oerr)
    }
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return err_detail_envelope("second_writer", "another writer holds the storage lock")
    }
    if fault() == "write_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=write_fail")
    }
    var id int = next_id_on(db)
    var ins int = db.exec("INSERT INTO todos(id, text, done) VALUES(" + json.encode(id) + ", " + sql_str(text) + ", 0)")
    if ins < 0 {
        db.exec("ROLLBACK")
        return err_envelope("storage_unwritable")
    }
    var bump int = bump_next_id_on(db, id)
    if bump < 0 {
        db.exec("ROLLBACK")
        return err_envelope("storage_unwritable")
    }
    if fault() == "commit_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=commit_fail (rolled back, no partial state)")
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return err_envelope("storage_unwritable")
    }
    // 备份先于故障返回：commit ⇒ bak 含该提交，损坏恢复不丢已确认数据
    backup_after_commit(db)
    if fault() == "after_commit_fail" {
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=after_commit_fail (committed before the failure report; recovery from backup keeps the committed item)")
    }
    var todo str = "{\"id\":" + json.encode(id) + ",\"text\":" + json.encode(text) + ",\"done\":false}"
    return ok_envelope(todo, 1)
}

pub fn repo_update(id int, text str, done bool) str {
    if is_blank_text(text) {
        return err_detail_envelope("blank_input", "todo text must not be blank")
    }
    var oerr str = open_repository()
    if oerr != "" {
        return err_envelope(oerr)
    }
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return err_detail_envelope("second_writer", "another writer holds the storage lock")
    }
    if fault() == "write_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=write_fail")
    }
    var rows List<List<str>> = db.query("SELECT id FROM todos WHERE id=" + json.encode(id))
    if rows.len() < 1 {
        db.exec("ROLLBACK")
        return err_detail_envelope("not_found", "no todo with the given id")
    }
    var d int = 0
    if done {
        d = 1
    }
    var upd int = db.exec("UPDATE todos SET text=" + sql_str(text) + ", done=" + json.encode(d) + " WHERE id=" + json.encode(id))
    if upd < 0 {
        db.exec("ROLLBACK")
        return err_envelope("storage_unwritable")
    }
    if fault() == "commit_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=commit_fail (rolled back, no partial state)")
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return err_envelope("storage_unwritable")
    }
    // 备份先于故障返回：commit ⇒ bak 含该提交，损坏恢复不丢已确认数据
    backup_after_commit(db)
    if fault() == "after_commit_fail" {
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=after_commit_fail (committed before the failure report; recovery from backup keeps the committed item)")
    }
    var todo str = "{\"id\":" + json.encode(id) + ",\"text\":" + json.encode(text) + ",\"done\":" + json.encode(done) + "}"
    return ok_envelope(todo, 1)
}

pub fn repo_delete(id int) str {
    var oerr str = open_repository()
    if oerr != "" {
        return err_envelope(oerr)
    }
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return err_detail_envelope("second_writer", "another writer holds the storage lock")
    }
    if fault() == "write_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=write_fail")
    }
    var rows List<List<str>> = db.query("SELECT text, done FROM todos WHERE id=" + json.encode(id))
    if rows.len() < 1 {
        db.exec("ROLLBACK")
        return err_detail_envelope("not_found", "no todo with the given id")
    }
    var row0 = rows[0]
    var del int = db.exec("DELETE FROM todos WHERE id=" + json.encode(id))
    if del < 0 {
        db.exec("ROLLBACK")
        return err_envelope("storage_unwritable")
    }
    if fault() == "commit_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=commit_fail (rolled back, no partial state)")
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return err_envelope("storage_unwritable")
    }
    // 备份先于故障返回：commit ⇒ bak 含该提交，损坏恢复不丢已确认数据
    backup_after_commit(db)
    if fault() == "after_commit_fail" {
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=after_commit_fail (committed before the failure report; recovery from backup keeps the committed item)")
    }
    var done str = "false"
    if row0[1] == "1" {
        done = "true"
    }
    var todo str = "{\"id\":" + json.encode(id) + ",\"text\":" + json.encode(row0[0]) + ",\"done\":" + done + "}"
    return ok_envelope(todo, 1)
}

/// 清已完成（语义沿 v0.5：恒清 done=1，参数保留签名兼容）。
pub fn repo_remove_completed() str {
    var oerr str = open_repository()
    if oerr != "" {
        return err_envelope(oerr)
    }
    var db SqliteDb = sqlite.open(db_path())
    var begin int = db.exec("BEGIN IMMEDIATE")
    if begin < 0 {
        return err_envelope("second_writer")
    }
    if fault() == "write_fail" {
        db.exec("ROLLBACK")
        return err_envelope("fault_injected")
    }
    var cnt_rows List<List<str>> = db.query("SELECT COUNT(*) FROM todos WHERE done=1")
    var cnt int = 0
    if cnt_rows.len() > 0 {
        var c = cnt_rows[0]
        cnt = parse_int(c[0])
    }
    var del int = db.exec("DELETE FROM todos WHERE done=1")
    if del < 0 {
        db.exec("ROLLBACK")
        return err_envelope("storage_unwritable")
    }
    if fault() == "commit_fail" {
        db.exec("ROLLBACK")
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=commit_fail (rolled back, no partial state)")
    }
    var commit int = db.exec("COMMIT")
    if commit < 0 {
        return err_envelope("storage_unwritable")
    }
    // 备份先于故障返回：commit ⇒ bak 含该提交，损坏恢复不丢已确认数据
    backup_after_commit(db)
    if fault() == "after_commit_fail" {
        return err_detail_envelope("fault_injected", "AUTO_TODO_FAULT=after_commit_fail (committed before the failure report; recovery from backup keeps the committed item)")
    }
    return ok_envelope("{\"id\":-1,\"text\":\"\",\"done\":false}", cnt)
}

// ═══════════════════════════════════════════════════════════
// 诊断
// ═══════════════════════════════════════════════════════════

/// 存储诊断：目录、版本、计数、分配器、备份在位情况。
pub fn repo_status() str {
    var dir str = data_dir()
    var oerr str = ensure_schema()
    var sv str = ""
    var cnt int = 0
    var nid int = 0
    if oerr == "" {
        var db SqliteDb = sqlite.open(db_path())
        sv = meta_get_on(db, "schema_v")
        var cnt_rows List<List<str>> = db.query("SELECT COUNT(*) FROM todos")
        if cnt_rows.len() > 0 {
            var c = cnt_rows[0]
            cnt = parse_int(c[0])
        }
        nid = next_id_on(db)
    }
    var s str = "{\"ok\":"
    if oerr == "" {
        s = s + "true"
    } else {
        s = s + "false"
    }
    s = s + ",\"err_code\":" + json.encode(oerr)
    s = s + ",\"err_detail\":" + json.encode(sqlite.last_error())
    s = s + ",\"data_dir\":" + json.encode(dir)
    s = s + ",\"db_path\":" + json.encode(db_path())
    s = s + ",\"schema_v\":" + json.encode(sv)
    s = s + ",\"count\":" + json.encode(cnt)
    s = s + ",\"next_id\":" + json.encode(nid)
    s = s + ",\"backup_exists\":" + json.encode(fs.exists(bak_path()))
    s = s + ",\"fault\":" + json.encode(fault())
    s = s + "}"
    return s
}
